# Bootstrap server — production defaults for India. Copy to .env and adjust.

# ── Identity ─────────────────────────────────────────────────────────────────
# REQUIRED in production: generate once with GENERATE_SEED=true ./bootstrap
# 64 hex chars (32 bytes). If unset, server exits unless BOOTSTRAP_DEV_MODE=true.
# BOOTSTRAP_IDENTITY_SEED=<64 hex chars>

# LOCAL DEV ONLY — allows deterministic seed fallback. NEVER set true in production.
# BOOTSTRAP_DEV_MODE=true

# ── Ports ────────────────────────────────────────────────────────────────────
BOOTSTRAP_PORT=4001
BOOTSTRAP_WS_PORT=4002
BOOTSTRAP_RIDER_BRIDGE_PORT=4003
BOOTSTRAP_DRIVER_BRIDGE_PORT=4004
BOOTSTRAP_HTTP_PORT=4005

# ── Environment ─────────────────────────────────────────────────────────────
# prod | staging | dev. Controls GossipSub topic namespacing:
#   prod:    /ridechain/prod/{city}/p2p/v1
#   staging: /ridechain/staging/{city}/p2p/v1
#   dev:     /ridechain/dev/{city}/p2p/v1  (default)
# CRITICAL: Set to prod in production — staging/dev traffic is isolated.
BOOTSTRAP_ENV=prod

# ── GossipSub ────────────────────────────────────────────────────────────────
# Override default topic (default auto-derived from BOOTSTRAP_ENV above)
# Must start with /ridechain/
# BOOTSTRAP_GOSSIPSUB_TOPIC=/ridechain/prod/in/p2p/v1

# ── Redis ────────────────────────────────────────────────────────────────────
# Peer registration, discover, search-by-name, FCM lookup, offline message inbox
REDIS_URL=redis://localhost:6379

# ── Firebase FCM ─────────────────────────────────────────────────────────────
# Set ONE of the following. On GCP VM with correct IAM role, leave both unset (uses ADC).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/ridechain-bootstrap/firebase-sa.json
# FIREBASE_SERVICE_ACCOUNT_JSON=./path/to/serviceAccountKey.json
# FCM_DISABLED=true   # disable push entirely (e.g. during testing)

# ── Rider Bridge ─────────────────────────────────────────────────────────────
# Max simultaneous WebSocket connections from riders (default: 5000)
# MAX_RIDER_CONNECTIONS=5000

# Comma-separated allowed WebSocket origins. Empty = allow all (dev mode).
# In production, set to your app domain(s).
# RIDER_ALLOWED_ORIGINS=https://app.ridechain.in,https://ridechain.in

# ── HTTP API Rate Limiting ─────────────────────────────────────────────────
# Per-IP token bucket. Default: 100 req/min, burst 20.
# BOOTSTRAP_API_RATE_LIMIT=100
# BOOTSTRAP_API_BURST=20

# ── Prometheus Metrics ───────────────────────────────────────────────────────
# Scrape: GET http://<host>:9090/metrics   Health: GET /healthz
# BOOTSTRAP_METRICS_PORT=9090

# ── Firebase Analytics (GA4 Measurement Protocol) ────────────────────────────
# Server-side events: peer_connect, message_sent, nearby_broadcast, etc.
# Get from GA4 property: Admin → Data Streams → Measurement Protocol API secrets
# FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# FIREBASE_ANALYTICS_SECRET=<api_secret>

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug  # verbose: conn_evt, relay, gossipsub_message, peer_stats
